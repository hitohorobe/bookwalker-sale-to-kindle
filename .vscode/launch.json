{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python デバッガー: 現在のファイル",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/make_kindle_link.py",
            "console": "integratedTerminal",
            "args": [
                // ここにbookwalkerのURLを入れて動作確認する
                "https://bookwalker.jp/campaign/40852"
            ],
            "envFile": "${workspaceFolder}/.env"
        },
        {
            "name": "Python デバッガー: 現在のファイル",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "envFile": "${workspaceFolder}/.env",
        },
        {
            "name": "FastAPI",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "main:app",
                "--reload",
                "--host",
                "0.0.0.0",
                "--port",
                "8000"
            ],
            "cwd": "${workspaceFolder}/app",
            "envFile": "${workspaceFolder}/.env"
        }
    ]
}